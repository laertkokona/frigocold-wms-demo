generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  movements    Movement[]
  @@map("users")
}

model LoginAttempt {
  key            String   @id @db.VarChar(200)
  count          Int
  firstAttemptAt DateTime @map("first_attempt_at")
  @@map("login_attempts")
}

model Operation {
  key         String   @id @db.Uuid
  kind        String   @db.VarChar(30)
  payloadHash String   @map("payload_hash") @db.VarChar(64)
  resultId    String?  @map("result_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("operations")
}

model Product {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique @db.VarChar(150)
  weightType String     @map("weight_type") @db.VarChar(20)
  fixedKg    Decimal?   @map("fixed_kg") @db.Decimal(10, 3)
  origin     String?    @db.VarChar(100)
  shipments  Shipment[]
  @@map("products")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(150)
  country   String     @db.VarChar(100)
  contact   String?    @db.VarChar(150)
  phone     String?    @db.VarChar(50)
  shipments Shipment[]
  @@map("suppliers")
}

model Client {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @unique @db.VarChar(150)
  city    String  @db.VarChar(100)
  contact String? @db.VarChar(150)
  phone   String? @db.VarChar(50)
  sales   Sale[]
  @@map("clients")
}

model Shipment {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
  orderNr     String    @map("order_nr") @db.VarChar(100)
  loadType    String    @map("load_type") @db.VarChar(20)
  countDoc    Int       @map("count_doc")
  countActual Int       @map("count_actual")
  netKgDoc    Decimal   @map("net_kg_doc") @db.Decimal(12, 3)
  netKgActual Decimal   @map("net_kg_actual") @db.Decimal(12, 3)
  costPerKg   Decimal   @map("cost_per_kg") @db.Decimal(12, 4)
  dateMode    String    @map("date_mode") @db.VarChar(20)
  prodFrom    String    @map("prod_from") @db.VarChar(10)
  prodTo      String?   @map("prod_to") @db.VarChar(10)
  expFrom     String    @map("exp_from") @db.VarChar(10)
  expTo       String?   @map("exp_to") @db.VarChar(10)
  entryDate   String    @map("entry_date") @db.VarChar(10)
  createdAt   DateTime  @default(now()) @map("created_at")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lots        ShipmentLot[]
  saleLines   SaleLine[]
  movements   Movement[]
  @@index([productId, expFrom])
  @@index([supplierId])
  @@index([orderNr])
  @@map("shipments")
}

model ShipmentLot {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  lotNumber  String   @map("lot_number") @db.VarChar(100)
  qty        Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  @@unique([shipmentId, lotNumber])
  @@index([lotNumber])
  @@map("shipment_lots")
}

model Draft {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  data      Json
  savedAt   DateTime @updatedAt @map("saved_at")
  @@map("drafts")
}

model Sale {
  id        String     @id @default(uuid()) @db.Uuid
  clientId  String     @map("client_id") @db.Uuid
  date      String     @db.VarChar(10)
  createdAt DateTime   @default(now()) @map("created_at")
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines     SaleLine[]
  movements Movement[]
  @@index([clientId, date])
  @@map("sales")
}

model SaleLine {
  id         String   @id @default(uuid()) @db.Uuid
  saleId     String   @map("sale_id") @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  method     String   @db.VarChar(20)
  qty        Int
  kg         Decimal  @db.Decimal(12, 3)
  pricePerKg Decimal  @map("price_per_kg") @db.Decimal(12, 4)
  weights    Json?
  fixedKg    Decimal? @map("fixed_kg") @db.Decimal(10, 3)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  @@index([shipmentId])
  @@map("sale_lines")
}

// Append-only stock ledger. Stock is the signed sum of kg per shipment.
model Movement {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  saleId     String?  @map("sale_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.VarChar(20)
  kg         Decimal  @db.Decimal(12, 3)
  qty        Int
  createdAt  DateTime @default(now()) @map("created_at")
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([shipmentId])
  @@map("movements")
}

model Settings {
  id               Int  @id @default(1)
  expiryDays       Int  @map("expiry_days")
  lowShipmentCount Int  @map("low_shipment_count")
  lowProductKg     Json @map("low_product_kg")
  @@map("settings")
}
